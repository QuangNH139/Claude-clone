# ── Frontend – Firebase config (PUBLIC, bắt đầu bằng VITE_) ────
# Lấy từ Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ── Backend local dev – không commit ───────────────────────────
# Service account JSON (dùng cho server.local.js và Vercel)
# Lấy từ Firebase Console → Project Settings → Service accounts → Generate key
# Dán toàn bộ JSON vào một dòng (bỏ xuống dòng)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
